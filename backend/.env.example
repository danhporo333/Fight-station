# Môi trường: development | test | production
NODE_ENV=development
PORT=3000

# MySQL 8.4 (Prisma CLI và app đều đọc biến này)
DATABASE_URL="mysql://user:password@localhost:3306/fight_station"

# Chuỗi ngẫu nhiên ≥ 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Danh sách origin được phép, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Tài khoản owner đầu tiên, tạo bằng `npx prisma db seed` (bỏ qua nếu username đã có)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
