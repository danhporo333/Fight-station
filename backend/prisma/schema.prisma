// Schema Fight Station — quy ước xem 01-share-docs/DATABASE.md
// Model thêm theo từng feature (/be-crud), migration: npm run prisma:migrate -- --name <động_từ>_<đối_tượng>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// ─── auth ───────────────────────────────────────────────────────────────

enum AdminRole {
  owner
  staff
}

model AdminUser {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  username     String    @unique(map: "idx_admin_user_username") @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(staff)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("admin_user")
}

// ─── shop ───────────────────────────────────────────────────────────────

// Chỉ có dòng id = 1 (CHECK (id = 1) thêm tay trong migration).
// Không auto-increment vì MySQL không cho CHECK trên cột AUTO_INCREMENT.
model Shop {
  id           Int      @id @default(1) @db.UnsignedInt
  name         String   @db.VarChar(100)
  tagline      String?  @db.VarChar(500)
  hoursLabel   String?  @map("hours_label") @db.VarChar(50)
  hotline      String?  @db.VarChar(20)
  email        String?  @db.VarChar(255)
  facebookUrl  String?  @map("facebook_url") @db.VarChar(500)
  zaloUrl      String?  @map("zalo_url") @db.VarChar(500)
  tiktokUrl    String?  @map("tiktok_url") @db.VarChar(500)
  instagramUrl String?  @map("instagram_url") @db.VarChar(500)
  youtubeUrl   String?  @map("youtube_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("shop")
}

// ─── branch ─────────────────────────────────────────────────────────────

model Branch {
  id           Int               @id @default(autoincrement()) @db.UnsignedInt
  name         String            @db.VarChar(100)
  address      String            @db.VarChar(255)
  phone        String?           @db.VarChar(20)
  openHours    String?           @map("open_hours") @db.VarChar(100)
  ps5Count     Int               @default(0) @map("ps5_count") @db.UnsignedSmallInt
  vipRoomCount Int               @default(0) @map("vip_room_count") @db.UnsignedSmallInt
  pcRoomCount  Int               @default(0) @map("pc_room_count") @db.UnsignedSmallInt
  areaM2       Int?              @map("area_m2") @db.UnsignedSmallInt
  mapUrl       String?           @map("map_url") @db.VarChar(500)
  facebookUrl  String?           @map("facebook_url") @db.VarChar(500)
  zaloUrl      String?           @map("zalo_url") @db.VarChar(500)
  sortOrder    Int               @default(0) @map("sort_order")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  // Game có ở chi nhánh này (bảng nối thuộc feature game)
  games        BranchGame[]
  // Gói giá áp dụng ở chi nhánh này (bảng nối thuộc feature price-plan)
  pricePlans   PricePlanBranch[]

  @@index([isActive, sortOrder], map: "idx_branch_is_active_sort_order")
  @@map("branch")
}

// ─── game ───────────────────────────────────────────────────────────────

// Màu nhấn của thẻ (game, promotion): khai báo một lần, feature sau dùng lại
enum AccentColor {
  orange
  red
  amber
  gold
}

model GameCategory {
  id        Int                @id @default(autoincrement()) @db.UnsignedInt
  name      String             @unique(map: "idx_game_category_name") @db.VarChar(50)
  sortOrder Int                @default(0) @map("sort_order")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  // Game thuộc thể loại này (bảng nối nhiều-nhiều)
  games     GameGameCategory[]

  @@map("game_category")
}

model Game {
  id          Int                @id @default(autoincrement()) @db.UnsignedInt
  title       String             @unique(map: "idx_game_title") @db.VarChar(150)
  players     String?            @db.VarChar(20)
  posterUrl   String?            @map("poster_url") @db.VarChar(500)
  accentColor AccentColor        @default(orange) @map("accent_color")
  description String?            @db.Text
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  // Thể loại của game (1–5, bảng nối nhiều-nhiều)
  categories  GameGameCategory[]
  // Không có dòng nào = có ở mọi chi nhánh
  branches    BranchGame[]

  @@index([isActive, sortOrder], map: "idx_game_is_active_sort_order")
  @@map("game")
}

// Game nào có ở chi nhánh nào. Game KHÔNG có dòng nào = có ở mọi chi nhánh.
// Xóa chi nhánh hoặc game thì dòng nối tự xóa (CASCADE).
model BranchGame {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  branchId  Int      @map("branch_id") @db.UnsignedInt
  gameId    Int      @map("game_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([branchId, gameId], map: "idx_branch_game_branch_id_game_id")
  @@index([gameId], map: "idx_branch_game_game_id")
  @@map("branch_game")
}

// Game thuộc thể loại nào (nhiều-nhiều): một game có 1–5 thể loại.
// Xóa game thì dòng nối tự xóa (CASCADE); xóa thể loại còn game bị chặn (RESTRICT).
model GameGameCategory {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  gameId         Int          @map("game_id") @db.UnsignedInt
  gameCategoryId Int          @map("game_category_id") @db.UnsignedInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameCategory   GameCategory @relation(fields: [gameCategoryId], references: [id], onDelete: Restrict)

  @@unique([gameId, gameCategoryId], map: "idx_game_game_category_game_id_game_category_id")
  @@index([gameCategoryId], map: "idx_game_game_category_game_category_id")
  @@map("game_game_category")
}

// ─── price-plan ─────────────────────────────────────────────────────────

// Gói giá giờ chơi. CHECK (price_vnd >= 0) thêm tay trong migration.
model PricePlan {
  id          Int                @id @default(autoincrement()) @db.UnsignedInt
  name        String             @db.VarChar(100)
  priceVnd    Int                @map("price_vnd") @db.UnsignedInt
  unit        String             @default("/giờ") @db.VarChar(30)
  // Dòng phụ dưới giá, vd "Giờ thường — Thứ 2 đến Thứ 6"
  description String?            @db.VarChar(255)
  isHot       Boolean            @default(false) @map("is_hot")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  features    PricePlanFeature[]
  // Chi nhánh áp dụng; không có dòng nào = áp dụng mọi chi nhánh
  branches    PricePlanBranch[]

  @@index([isActive, sortOrder], map: "idx_price_plan_is_active_sort_order")
  @@map("price_plan")
}

// Gói giá áp dụng ở chi nhánh nào (nhiều-nhiều). Gói không có dòng nào ở đây = áp dụng mọi chi nhánh.
model PricePlanBranch {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  pricePlanId Int       @map("price_plan_id") @db.UnsignedInt
  branchId    Int       @map("branch_id") @db.UnsignedInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  pricePlan   PricePlan @relation(fields: [pricePlanId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([pricePlanId, branchId], map: "idx_price_plan_branch_price_plan_id_branch_id")
  @@index([branchId], map: "idx_price_plan_branch_branch_id")
  @@map("price_plan_branch")
}

// Quyền lợi của gói, mỗi dòng một ý. Xóa gói thì xóa theo (CASCADE).
model PricePlanFeature {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  pricePlanId Int       @map("price_plan_id") @db.UnsignedInt
  content     String    @db.VarChar(255)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  pricePlan   PricePlan @relation(fields: [pricePlanId], references: [id], onDelete: Cascade)

  @@index([pricePlanId], map: "idx_price_plan_feature_price_plan_id")
  @@map("price_plan_feature")
}

// ─── menu ───────────────────────────────────────────────────────────────

model MenuCategory {
  id        Int        @id @default(autoincrement()) @db.UnsignedInt
  name      String     @unique(map: "idx_menu_category_name") @db.VarChar(50)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  items     MenuItem[]

  @@map("menu_category")
}

// Món ăn, nước uống. is_available = false là "tạm hết" (vẫn hiện); is_active = false mới là ẩn.
// CHECK (price_vnd >= 0) thêm tay trong migration.
model MenuItem {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  menuCategoryId Int          @map("menu_category_id") @db.UnsignedInt
  name           String       @db.VarChar(150)
  description    String?      @db.VarChar(255)
  priceVnd       Int          @map("price_vnd") @db.UnsignedInt
  imageUrl       String?      @map("image_url") @db.VarChar(500)
  isAvailable    Boolean      @default(true) @map("is_available")
  // Món bán chạy: trang khách hiện huy hiệu "Best seller"
  isBestSeller   Boolean      @default(false) @map("is_best_seller")
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  // Xóa nhóm còn món bị chặn (RESTRICT)
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Restrict)

  // Tên món không trùng trong cùng nhóm; cũng phục vụ lọc theo nhóm (không cần index riêng cho FK)
  @@unique([menuCategoryId, name], map: "idx_menu_item_menu_category_id_name")
  @@map("menu_item")
}
