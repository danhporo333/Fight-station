// Schema Fight Station — quy ước xem 01-share-docs/DATABASE.md
// Model thêm theo từng feature (/be-crud), migration: npm run prisma:migrate -- --name <động_từ>_<đối_tượng>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// ─── auth ───────────────────────────────────────────────────────────────

enum AdminRole {
  owner
  staff
}

model AdminUser {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  username     String    @unique(map: "idx_admin_user_username") @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(staff)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("admin_user")
}

// ─── shop ───────────────────────────────────────────────────────────────

// Chỉ có dòng id = 1 (CHECK (id = 1) thêm tay trong migration).
// Không auto-increment vì MySQL không cho CHECK trên cột AUTO_INCREMENT.
model Shop {
  id           Int      @id @default(1) @db.UnsignedInt
  name         String   @db.VarChar(100)
  tagline      String?  @db.VarChar(500)
  hoursLabel   String?  @map("hours_label") @db.VarChar(50)
  hotline      String?  @db.VarChar(20)
  email        String?  @db.VarChar(255)
  facebookUrl  String?  @map("facebook_url") @db.VarChar(500)
  zaloUrl      String?  @map("zalo_url") @db.VarChar(500)
  tiktokUrl    String?  @map("tiktok_url") @db.VarChar(500)
  instagramUrl String?  @map("instagram_url") @db.VarChar(500)
  youtubeUrl   String?  @map("youtube_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("shop")
}

// ─── branch ─────────────────────────────────────────────────────────────

model Branch {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  name         String   @db.VarChar(100)
  address      String   @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  openHours    String?  @map("open_hours") @db.VarChar(100)
  ps5Count     Int      @default(0) @map("ps5_count") @db.UnsignedSmallInt
  vipRoomCount Int      @default(0) @map("vip_room_count") @db.UnsignedSmallInt
  pcRoomCount  Int      @default(0) @map("pc_room_count") @db.UnsignedSmallInt
  areaM2       Int?     @map("area_m2") @db.UnsignedSmallInt
  mapUrl       String?  @map("map_url") @db.VarChar(500)
  facebookUrl  String?  @map("facebook_url") @db.VarChar(500)
  zaloUrl      String?  @map("zalo_url") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([isActive, sortOrder], map: "idx_branch_is_active_sort_order")
  @@map("branch")
}
